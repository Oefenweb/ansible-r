#!/usr/bin/env Rscript

argv = commandArgs(trailingOnly = TRUE);
if (is.null(argv) | length(argv) < 1) {
  cat("Usage: R-update-package package [alias] [type] [lib] [repos]\n");
  q(status = 1);
}

type =  ifelse(is.na(argv[2]), '{{ r_packages_type }}', argv[2]);
lib = ifelse(is.na(argv[3]), '{{ r_packages_lib }}', argv[3]);
repos = ifelse(is.na(argv[4]), '{{ r_packages_repos.rstrip('/') }}', argv[4]);

package = argv[1];
alias = ifelse(is.na(argv[2]), package, argv[2]);
if (type == 'github') {
  repo = argv[1];
  package = unlist(strsplit(repo, '/'))[2];
  alias = ifelse(is.na(argv[2]), package, argv[2]);
}

if (!('pak' %in% installed.packages(lib.loc = lib)[, 'Package'])) {
  install.packages(
    'pak',
    repos = sprintf(
      "https://r-lib.github.io/p/pak/stable/%s/%s/%s",
      .Platform$pkgType,
      R.Version()$os,
      R.Version()$arch
    )
  );
}

if (type == 'cran') {
  withCallingHandlers({
    pak::repo_add(CRAN = repos)
    pak::pkg_install(package, lib = lib, upgrade = TRUE);
    cat("changed\n");
  }, warning = stop);
} else if (type == 'github') {
  withCallingHandlers({
    pak::pkg_install(repo, lib = lib, upgrade = TRUE);
    cat("changed\n");
  }, warning = stop);
} else if (type == 'bitbucket') {
  withCallingHandlers({
    remotes::install_bitbucket(repo, lib = lib, upgrade = TRUE);
    cat("changed\n");
  }, warning = stop);
} else if (type == 'bioconductor') {
  withCallingHandlers({
    pak::pkg_install(paste('bioc', package, sep='::'), lib = lib, upgrade = TRUE);
    cat("changed\n");
  }, warning = stop);
} else {
  cat("Unrecognised type\n");
  q(status = 1);
}
