#!/usr/bin/env Rscript

argv = commandArgs(trailingOnly = TRUE);
if (is.null(argv) | length(argv) < 1) {
  cat("Usage: R-install-package package [alias] [type] [lib] [repos]\n");
  q(status = 1);
}

type = ifelse(is.na(argv[3]), '{{ r_packages_type }}', argv[3]);
lib = ifelse(is.na(argv[4]), '{{ r_packages_lib }}', argv[4]);
repos = ifelse(is.na(argv[5]), '{{ r_packages_repos.rstrip('/') }}', argv[5]);

package = argv[1];
alias = ifelse(is.na(argv[2]), package, argv[2]);
if (type == 'github') {
  repo = argv[1];
  package = unlist(strsplit(repo, '/'))[2];
  alias = ifelse(is.na(argv[2]), package, argv[2]);
}

if (!('pak' %in% installed.packages(lib.loc = lib)[, 'Package'])) {
  install.packages(
    'pak',
    repos = sprintf(
      "https://r-lib.github.io/p/pak/stable/%s/%s/%s",
      .Platform$pkgType,
      R.Version()$os,
      R.Version()$arch
    )
  );
}

{% if not r_list_packages_once %}
if (!(alias %in% installed.packages(lib.loc = lib)[, 'Package'])) {
{% endif %}
  if (type == 'cran') {
    withCallingHandlers({
      pak::repo_add(CRAN = repos)
      pak::pkg_install(package, lib = lib, upgrade = FALSE);
      cat("changed\n");
    }, warning = stop);
  } else if (type == 'github') {
    withCallingHandlers({
      pak::pkg_install(repo, lib = lib, upgrade = FALSE);
      cat("changed\n");
    }, warning = stop);
  } else if (type == 'bitbucket') {
    withCallingHandlers({
      remotes::install_bitbucket(repo, lib = lib, upgrade = FALSE);
      cat("changed\n");
    }, warning = stop);
  } else if (type == 'bioconductor') {
    withCallingHandlers({
      pak::pkg_install(paste('bioc', package, sep='::'), lib = lib, upgrade = FALSE);
      cat("changed\n");
    }, warning = stop);
  } else {
    cat("Unrecognised type\n");
    q(status = 1);
  }
{% if not r_list_packages_once %}
}
{% endif %}
