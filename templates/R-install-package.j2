#!/usr/bin/env Rscript

argv = commandArgs(trailingOnly = TRUE);
if (is.null(argv) | length(argv) < 1) {
  cat("Usage: R-install-package package [type] [lib] [repos]\n");
  q(status = 1);
}

type = ifelse(is.na(argv[2]), '{{ r_packages_type }}', argv[2]);
lib = ifelse(is.na(argv[3]), '{{ r_packages_lib }}', argv[3]);
repos = ifelse(is.na(argv[4]), '{{ r_packages_repos.rstrip('/') }}', argv[4]);

if (type == 'github') {
  repo = argv[1];
  package = unlist(strsplit(repo, '/'))[2];
} else {
  package = argv[1];
}

if (!('pak' %in% installed.packages(lib.loc = lib)[, 'Package'])) {
  install.packages(
    'pak',
    repos = sprintf(
      "https://r-lib.github.io/p/pak/stable/%s/%s/%s",
      .Platform$pkgType,
      R.Version()$os,
      R.Version()$arch
    )
  );
}

{% if not r_list_packages_once %}
if (!(package %in% installed.packages(lib.loc = lib)[, 'Package'])) {
{% endif %}
  if (type == 'cran') {
    withCallingHandlers({
      pak::pkg_install(package, lib = lib, update = FALSE);
      cat("changed\n");
    }, warning = stop);
  } else {
    if (type == 'bioconductor') {
      withCallingHandlers({
        pak::pak(paste('bioc', package, sep='::'), lib = lib, update = FALSE);
        cat("changed\n");
      }, warning = stop);
    } else if (type == 'github') {
      withCallingHandlers({
        pak::pak(repo, lib = lib, update = FALSE);
        cat("changed\n");
      }, warning = stop);
    } else if (type == 'bitbucket') {
      withCallingHandlers({
        remotes::install_bitbucket(repo, lib = lib, update = FALSE);
        cat("changed\n");
      }, warning = stop);
    } else {
      cat("Unrecognised type\n");
      q(status = 1);
    }
  }
{% if not r_list_packages_once %}
}
{% endif %}
