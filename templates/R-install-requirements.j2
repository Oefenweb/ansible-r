#!/usr/bin/env bash
#
{{ ansible_managed | comment }}
#
# set -x;
set -e;
set -o pipefail;
#
thisFile="$(readlink -f "${0}")";
thisFilePath="$(dirname "${thisFile}")";

if [ -z "${1}" ] || [ "${1}" != '-r' ] || [ -z "${2}" ]; then
  echo "Usage: ${0} -r requirements.txt";
  exit 1;
fi

if [ ! -f "${2}" ]; then
  echo "Could not open requirements file for reading";
  exit 1;
fi

requirementsFile="${2}";
shift 2;

Rscript -e "
withCallingHandlers({
  if (!('pak' %in% installed.packages()[, 'Package'])) {
    install.packages(
      'pak',
      repos = sprintf(
        \"https://r-lib.github.io/p/pak/stable/%s/%s/%s\",
        .Platform\$pkgType,
        R.Version()\$os,
        R.Version()\$arch
      )
    );
  }
}, warning = stop)
";

while IFS= read -r requirement; do
  requirementType="$(echo "${requirement}" | awk -F'::' '{ print $1}')";
  requirementName="$(echo "${requirement}" | awk -F'::' '{ print $2}' | awk -F'@' '{ print $1}')";
  requirementVersion="$(echo "${requirement}" | awk -F'::' '{ print $2}' | awk -F'@' '{ print $2}')";

  installCommand="pak::pkg_install(\"${requirementName}\")";
  if [ -n "${requirementVersion}" ]; then
    installCommand="pak::pkg_install(\"${requirementName}@${requirementVersion}\")";
  fi

  if [ "${requirementType}" == 'bitbucket' ]; then
    installCommand="remotes::install_bitbucket(\"${requirementName}\")";
    if [ -n "${requirementVersion}" ]; then
      installCommand="remotes::install_bitbucket(\"${requirementName}\", ref=\"${requirementVersion}\")";
    fi
  elif [ "${requirementType}" == 'bioconductor' ]; then
    installCommand="pak::pkg_install(\"bioc::${requirementName}\")";
    if [ -n "${requirementVersion}" ]; then
      installCommand="pak::pkg_install(\"bioc::${requirementName}@${requirementVersion}\")";
    fi
  fi

  Rscript -e "
  withCallingHandlers({
    ${installCommand}
  }, warning = stop)
  ";
done < "${requirementsFile}"
